          "type": "string",
          "const": "page.prepare"
        },
        "clean_rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mask_rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ocr_result": {
          "type": "object",
          "properties": {
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "bubble",
                      "text_bubble",
                      "text_free"
                    ]
                  },
                  "bbox": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "polarity": {
                    "type": "string",
                    "enum": [
                      "dark_on_light",
                      "light_on_dark"
                    ]
                  },
                  "bubble_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
