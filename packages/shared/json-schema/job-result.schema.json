                        },
                        "font_family": {
                          "type": "string",
                          "minLength": 1
                        },
                        "font_size": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "line_height": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "pad": {
                          "type": "number",
                          "minimum": 0
