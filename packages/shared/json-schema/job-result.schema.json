{
  "$id": "https://mtl.local/schema/job-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chapter.ingest"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ord": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "original_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_map": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_file_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "src_y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "page_y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "h": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "source_file_id",
                    "src_y",
                    "page_y",
                    "h"
                  ],
                  "additionalProperties": false
                }
              },
              "cut_flag": {
                "type": "boolean"
              }
            },
            "required": [
              "ord",
              "width",
              "height",
              "original_sha256",
              "source_map",
              "cut_flag"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "pages"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
