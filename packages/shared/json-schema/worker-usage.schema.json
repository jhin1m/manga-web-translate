{
  "$id": "https://mtl.local/schema/worker-usage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "llm_in": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "llm_out": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gpu_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "seq",
    "model",
    "llm_in",
    "llm_out",
    "calls",
    "gpu_s"
  ],
  "additionalProperties": false
}
