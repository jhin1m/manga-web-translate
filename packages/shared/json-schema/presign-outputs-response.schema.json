{
  "$id": "https://mtl.local/schema/presign-outputs-response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "rev": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "put": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "rev",
          "put",
          "expires_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outputs"
  ],
  "additionalProperties": false
}
