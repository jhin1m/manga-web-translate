{
  "$id": "https://mtl.local/schema/claim-response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "enum": [
              "chapter.ingest",
              "page.prepare",
              "chapter.translate",
              "page.reinpaint",
              "page.ocr_region",
              "chapter.export"
            ]
          },
          "attempt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "lease_token": {
            "type": "string"
          },
          "lease_expires_at": {
            "type": "string"
          },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "chapter.ingest"
                  },
                  "chapter_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "ingest_rev": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "strip",
                      "pages"
                    ]
                  }
                },
                "required": [
                  "type",
                  "chapter_id",
                  "ingest_rev",
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "page.prepare"
                  },
                  "page_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "source_lang": {
                    "type": "string",
                    "minLength": 2
                  },
                  "reading_order": {
                    "type": "string",
                    "enum": [
                      "ltr",
                      "rtl"
                    ]
                  }
                },
                "required": [
                  "type",
                  "page_id",
                  "source_lang"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "chapter.translate"
                  },
                  "chapter_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "page_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "context": {
                    "type": "string",
                    "enum": [
                      "rolling",
                      "neighbors"
                    ]
                  },
                  "glossary_rev": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "settings_rev": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "glossary": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "source_lang": {
                        "type": "string",
                        "minLength": 2
                      },
                      "target_lang": {
                        "type": "string",
                        "minLength": 2
                      },
                      "pronoun_rules": {
                        "type": "string"
                      },
                      "honorific_policy": {
                        "type": "string"
                      },
                      "style_prompt": {
                        "type": "string"
                      },
                      "font": {
                        "type": "string",
                        "minLength": 1
                      },
                      "narration_font": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "glossary",
                      "pronoun_rules",
                      "honorific_policy",
                      "style_prompt",
                      "font"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "chapter_id",
                  "page_ids",
                  "context",
                  "glossary_rev",
                  "settings_rev",
                  "settings"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "page.reinpaint"
                  },
                  "page_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "base_clean_rev": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "user_mask_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "y": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "page_id",
                  "base_clean_rev",
                  "user_mask_key",
                  "offset"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "page.ocr_region"
                  },
                  "page_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "bbox": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "source_lang": {
                    "type": "string",
                    "minLength": 2
                  },
                  "target_lang": {
                    "type": "string",
                    "minLength": 2
                  }
                },
                "required": [
                  "type",
                  "page_id",
                  "bbox"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "chapter.export"
                  },
                  "chapter_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "png_zip",
                      "cbz"
                    ]
                  },
                  "layout": {
                    "type": "string",
                    "enum": [
                      "original_slices",
                      "pages"
                    ]
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "include_untranslated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "chapter_id",
                  "format",
                  "layout",
                  "quality",
                  "include_untranslated"
                ],
                "additionalProperties": false
              }
            ]
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "rev": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "put": {
                  "type": "string",
                  "format": "uri"
                },
                "expires_at": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "key",
                "rev",
                "put",
                "expires_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type",
          "attempt",
          "lease_token",
          "lease_expires_at",
          "payload",
          "inputs",
          "outputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "jobs"
  ],
  "additionalProperties": false
}
