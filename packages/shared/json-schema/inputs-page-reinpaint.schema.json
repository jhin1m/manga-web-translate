{
  "$id": "https://mtl.local/schema/inputs-page-reinpaint.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_clean": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/files\\/"
        }
      ]
    },
    "user_mask": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/files\\/"
        }
      ]
    }
  },
  "required": [
    "base_clean"
  ],
  "additionalProperties": false
}
