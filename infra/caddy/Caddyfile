# Caddy production sau Cloudflare (SSL "Full (strict)"): cert Cloudflare Origin CA cho cả 2 domain.
# Biến (systemd caddy: Environment / EnvironmentFile): APP_DOMAIN, FILES_DOMAIN, MTL_ROOT, ORIGIN_CERT, ORIGIN_KEY.
# Cài: sudo ln -sf /srv/mtl/current/infra/caddy/Caddyfile /etc/caddy/Caddyfile
{
	admin localhost:2019
	# Cert Origin CA do Cloudflare cấp — không xin ACME.
	auto_https disable_certs
	servers {
		# IP thật của client đi qua Cloudflare (danh sách IP: https://www.cloudflare.com/ips/ — cập nhật khi đổi).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(common) {
	tls {$ORIGIN_CERT} {$ORIGIN_KEY}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$APP_DOMAIN} {
	import common
	@api path /api/* /worker/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			# IP client đã giải qua trusted_proxies (Cloudflare) → better-auth rate limit theo IP thật.
			header_up X-Real-IP {client_ip}
		}
	}
	# SPA tĩnh của release hiện hành; route client-side → index.html.
	handle {
		root * {$MTL_ROOT:/srv/mtl}/current/apps/web/dist
		try_files {path} /index.html
		file_server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}

# Domain riêng cho file người dùng (red team #12): presigned URL ký theo host này, MinIO private.
# CORS chỉ cho APP_DOMAIN đặt ở MinIO (MINIO_API_CORS_ALLOW_ORIGIN, docker-compose.prod.yml).
{$FILES_DOMAIN} {
	import common
	# ">" = đặt sau response upstream (thay, không nhân đôi header MinIO).
	header >X-Content-Type-Options nosniff
	header >Content-Security-Policy "default-src 'none'; sandbox"
	# Giữ nguyên Host (mặc định của reverse_proxy) để chữ ký SigV4 khớp.
	reverse_proxy 127.0.0.1:9000
}
