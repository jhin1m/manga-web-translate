# Sao chép thành .env ở thư mục gốc. Giá trị dưới khớp infra/docker-compose.dev.yml.
DATABASE_URL=postgres://mtl:mtl@localhost:5442/mtl
# DB riêng cho test (tự tạo + migrate khi chạy `pnpm test`)
TEST_DATABASE_URL=postgres://mtl:mtl@localhost:5442/mtl_test

# better-auth: secret ≥ 32 ký tự ngẫu nhiên (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars
# URL trình duyệt gọi (dev: SPA Vite proxy /api về API)
BETTER_AUTH_URL=http://localhost:5180
WEB_ORIGIN=http://localhost:5180
API_PORT=8787

# Storage S3-compatible (MinIO). S3_ENDPOINT chỉ API dùng (nội bộ).
S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_BUCKET=mtl
S3_ACCESS_KEY=mtl-dev
S3_SECRET_KEY=mtl-dev-secret
# Domain file riêng mà trình duyệt thấy (presigned POST/GET ký theo host này). Prod: files.<domain>
FILES_DOMAIN=localhost:9100
FILES_SCHEME=http

# --- Production (Phase 7, xem docs/deployment-guide.md). Dev/test để trống = không giới hạn / tắt. ---
# Kill-switch ngân sách toàn cục (USD, ngày/tháng UTC). Bắt buộc khi NODE_ENV=production hoặc SIGNUP_ENABLED=true;
# 0 = chặn job tốn tiền. Ngưỡng ngày là MẶC ĐỊNH: admin đổi được trên UI (Cài đặt › Hạn mức & đăng ký), giá trị đó thắng env.
GLOBAL_DAILY_USD=10
GLOBAL_MONTHLY_USD=
# Email quản trị (phân tách bằng dấu phẩy): vào /settings và /api/admin/*. Đăng ký web bằng các email này luôn bị
# từ chối — tạo tài khoản admin bằng `pnpm create-user`. Trống = không ai là admin.
ADMIN_EMAILS=
# Khoá chính (32 byte base64) mã hoá key provider AI lưu trong DB: `openssl rand -base64 32`. Không đặt = không lưu /
# đổi được key provider trên Cài đặt → AI. BACKUP ngoài DB; mất hoặc đổi khoá = nhập lại key từng provider.
SECRETS_KEY=
# Đăng ký email/mật khẩu công khai trên /login — MẶC ĐỊNH khi admin chưa chỉnh trên UI. Không đặt = tắt (chỉ `pnpm
# create-user`). Bật thì bắt buộc GLOBAL_DAILY_USD + USER_DAILY_USD. Production: giữ false tới khi có xác thực email +
# hạn mức dung lượng (admin bật trên UI = chấp nhận đăng ký chưa xác thực email).
SIGNUP_ENABLED=true
# Hạn mức chi phí mỗi người dùng mỗi ngày UTC (USD, LLM + GPU). 0 = chặn mọi job LLM; trống = không giới hạn.
# Cũng là mặc định: giá trị admin đặt trên UI thắng.
USER_DAILY_USD=1
# Dispatcher Modal trong `pnpm jobs` (false = chỉ worker Mac)
DISPATCHER_ENABLED=false
MODAL_DRAIN_URL=
# ≥ 32 ký tự, trùng Modal secret `mtl-worker`
MODAL_DRAIN_SECRET=
MODAL_MAX_CONTAINERS=2
MODAL_SCALEDOWN_S=60
MODAL_MAX_LIFETIME_S=3600
# Kênh cảnh báo duy nhất: topic ntfy bí mật (VD https://ntfy.sh/<chuỗi-ngẫu-nhiên>)
ALERT_NTFY_URL=

# --- Chỉ dev: SPA tự đăng nhập tài khoản này khi chưa có phiên (cần NODE_ENV=development + BETTER_AUTH_URL localhost).
# Đặt ở production → API không khởi động. Đăng xuất trong tab → tab đó thôi tự đăng nhập. Mật khẩu ≥ 10 ký tự, tài khoản phải tồn tại sẵn (pnpm create-user).
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=

# --- Worker AI (Python, thư mục worker/). `pnpm dev:all` nạp file này cho worker qua `uv run --env-file`. ---
MTL_API_URL=http://localhost:8787
# Token tạo bằng `pnpm worker-token create ... --out ~/.config/mtl/worker.token`
MTL_TOKEN_FILE=~/.config/mtl/worker.token
# gemini | anthropic | openai | openai_compatible (key tương ứng bắt buộc, trừ khi chạy worker với --no-llm)
MTL_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# --- Worker: OpenAI / OpenAI-compatible (chọn bằng mtl-worker --provider openai|openai_compatible hoặc MTL_PROVIDER) ---
OPENAI_API_KEY=
# MTL_OPENAI_MODEL=gpt-4.1-mini
# MTL_OPENAI_PREMIUM_MODEL=gpt-4.1
# MTL_OPENAI_REASONING=0            # 1 = model reasoning: gửi reasoning_effort=low (chỉ OpenAI chính chủ)
MTL_OPENAI_COMPAT_BASE_URL=         # vd https://openrouter.ai/api/v1
MTL_OPENAI_COMPAT_API_KEY=
MTL_OPENAI_COMPAT_MODEL=
# MTL_OPENAI_COMPAT_JSON=json_schema   # json_schema | json_object (json_schema tự hạ json_object 1 lần nếu endpoint từ chối)
