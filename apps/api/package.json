{
  "name": "@mtl/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "auth:generate": "auth generate --config src/auth.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "jobs": "tsx src/jobs/runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-presigned-post": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@hono/node-server": "^2.1.5",
    "@mtl/db": "workspace:*",
    "@mtl/shared": "workspace:*",
    "better-auth": "1.7.11",
    "drizzle-orm": "^0.45.4",
    "fontkit": "^2.0.4",
    "hono": "^4.13.13",
    "nodemailer": "^10.2.0",
    "re2": "^1.27.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "auth": "1.7.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
